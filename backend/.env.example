# JWT Configuration
JWT_SECRET=your-secret-key-here-minimum-256-bits

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Electron App Token (for production CORS validation)
APP_ELECTRON_TOKEN=your-secure-random-token-here

# Database Configuration (for production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aiprofessor_prod
DB_USERNAME=root
DB_PASSWORD=your-db-password

# Redis Configuration (for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Zoho Mail SMTP Configuration
# Get app password from: https://accounts.zoho.com/home#security/settings
# ZOHO_USERNAME: Your actual Zoho Mail account for SMTP authentication
# ZOHO_APP_PASSWORD: App-specific password (not your regular password)
ZOHO_USERNAME=your-email@zohomail.com
ZOHO_APP_PASSWORD=your-app-password

# Email From Address (optional)
# If you want to send emails from a different address (e.g., contact@your-domain.com),
# you must configure it in Zoho Mail settings
# If not set, ZOHO_USERNAME will be used as the from address
MAIL_FROM_ADDRESS=

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:5173
