# JWT Configuration
JWT_SECRET=your-secret-key-here-minimum-256-bits

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Electron App Token (for production CORS validation)
APP_ELECTRON_TOKEN=your-secure-random-token-here

# Database Configuration (for production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aiprofessor_prod
DB_USERNAME=root
DB_PASSWORD=your-db-password

# Redis Configuration (for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Gmail SMTP Configuration
# Get app password from: https://myaccount.google.com/apppasswords
# GMAIL_USERNAME: Your actual Gmail account for SMTP authentication
# GMAIL_APP_PASSWORD: 16-character app password (not your regular password)
GMAIL_USERNAME=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Email From Address (optional)
# If you want to send emails from a different address (e.g., contact@your-domain.com),
# you must first add and verify this address in Gmail Settings > "Accounts and Import" > "Send mail as"
# If not set, GMAIL_USERNAME will be used as the from address
MAIL_FROM_ADDRESS=

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:5173
